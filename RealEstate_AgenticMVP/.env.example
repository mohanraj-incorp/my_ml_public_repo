# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Cloud SQL (PostgreSQL)
CLOUD_SQL_INSTANCE=your-project:us-central1:leasing-db
DB_NAME=leasing
DB_USER=leasing_app
DB_PASSWORD=your-db-password

# Redis (Cloud Memorystore) — used for idempotency key store + semantic cache
REDIS_HOST=10.0.0.3
REDIS_PORT=6379

# Vertex AI Vector Search — hosts policy document embeddings
VECTOR_SEARCH_INDEX_ENDPOINT=projects/YOUR_PROJECT/locations/us-central1/indexEndpoints/YOUR_ENDPOINT
VECTOR_SEARCH_DEPLOYED_INDEX_ID=leasing_policy_index

# GCS Buckets
GCS_PROPERTIES_BUCKET=realpage-properties-bucket
GCS_POLICY_DOCS_BUCKET=realpage-policy-docs
GCS_GOLDEN_DATASET_BUCKET=realpage-golden-dataset

# Firestore — long-term prospect memory
FIRESTORE_COLLECTION_PROSPECTS=prospects

# App limits
MAX_RECURSION_LIMIT=25
MAX_SESSION_TURNS=50
CONVERSATION_SUMMARY_THRESHOLD=12
